go 1.25.3

// Goose framework (local development — matches published v0.0.6)
use ../../awesome-goose/goose

// Shared gox-packages
use ../gox-packages/libs/core
use ../gox-packages/libs/blobs

// App modules
use (
	./libs/assets
	./libs/audit
	./libs/blobs
	./libs/bridge
	./libs/cache
	./libs/capital
	./libs/common
	./libs/controller
	./libs/cron
	./libs/figs
	./libs/flags
	./libs/forms
	./libs/fuss
	./libs/health
	./libs/identity
	./libs/notification
	./libs/polylog
	./libs/queue
	./libs/statics
)

// Workspace-only overrides so local development resolves to the in-tree copies
// of gox-packages libs before their tags are published. These are not used by
// consumers of the published modules.
replace github.com/thescaffold/gox-packages/libs/core v0.0.7 => ../gox-packages/libs/core
replace github.com/thescaffold/gox-packages/libs/blobs v0.0.7 => ../gox-packages/libs/blobs
